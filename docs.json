{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Marketplace",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Productos",
        "groups": [
          {
            "group": "Inicio",
            "pages": ["index", "arquitectura"]
          },
          {
            "group": "Productos",
            "pages": [
              "productos/ecommerce",
              "productos/pagos",
              "productos/kyc",
              "productos/voice",
              "productos/integraciones"
            ]
          }
        ]
      },
      {
        "tab": "Pendientes",
        "groups": [
          {
            "group": "Pendientes",
            "pages": ["pendientes"]
          },
          {
            "group": "Specs",
            "pages": ["specs/plantilla", "specs/ejemplo"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": ["copy", "view"]
  }
}
